# IBM watsonx.ai Configuration
IBM_WATSONX_API_KEY=your_api_key_here
IBM_WATSONX_PROJECT_ID=your_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite Model Configuration
GRANITE_MODEL_ID=ibm/granite-13b-chat-v2
GRANITE_MAX_TOKENS=1024
GRANITE_TEMPERATURE=0.7

# Langflow Configuration
LANGFLOW_API_URL=http://localhost:7860
LANGFLOW_API_KEY=your_langflow_key_here

# Application Configuration
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# Race Data Configuration
DEFAULT_RACE_LAPS=50
TIRE_DEGRADATION_RATE=0.02
FUEL_CONSUMPTION_RATE=1.5